# Copy this file to docker/.env and fill in real values:
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored — never commit real secrets.

# Only needed for the optional Sia path (`--profile sia`): the password
# indexd's Postgres database uses. Pick any strong value; it's local to your
# machine's Postgres container, not a Sia credential.
POSTGRES_PASSWORD=
